	(footprint "Keystone_1060_CR2032_SMT"
		(layer "F.Cu")
		(uuid "d8f01b86-496a-45e3-ac65-0a682c6fe6a9")
		(at 100 100 -90)
		(descr "Keystone 1060 SMT (Vibra-Fit) low-profile coin cell holder for CR2032/CR2025. Dims per official Keystone drawing 1060 rev C (https://www.keyelco.com/product-pdf.cfm?p=726): mounting pads 11.00x7.01 mm center + 2.59x3.61 mm end tabs, end-tab centers +/-14.655 mm (29.31 mm c-c); body 28.40x22.00 mm, H 5.51 mm, tabs to 31.90 mm overall. Center pad and one end tab are the negative terminal (spring contact on battery - face); the other end tab is positive (grips battery + can rim; battery inserts + face up). NOTE: Keystone 1059 is the THM variant - this SMT footprint was previously misnumbered 1059 with unverified dims.")
